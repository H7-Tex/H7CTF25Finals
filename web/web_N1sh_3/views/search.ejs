<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Search - SecureHR</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0d1117;
            color: #c9d1d9;
            line-height: 1.6;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #161b22 0%, #21262d 100%);
            border-bottom: 1px solid #30363d;
            padding: 2rem 0;
            text-align: center;
        }
        .header h1 {
            color: #f0f6fc;
            font-size: 2rem;
            font-weight: 600;
        }
        .nav-bar {
            background: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 1rem 0;
            margin-bottom: 2rem;
        }
        .nav-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .nav-link {
            color: #c9d1d9;
            text-decoration: none;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }
        .nav-link:hover, .nav-link.active {
            background: #21262d;
            border-color: #30363d;
            color: #f0f6fc;
        }
        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        .search-section {
            background: #161b22;
            border: 1px solid #30363d;
            padding: 2rem;
            border-radius: 8px;
            margin-bottom: 2rem;
        }
        .search-section h2 {
            color: #f0f6fc;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .search-form {
            display: flex;
            gap: 1rem;
            align-items: center;
        }
        input[type="text"] {
            flex: 1;
            padding: 0.75rem;
            background: #0d1117;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #c9d1d9;
            font-size: 14px;
            transition: border-color 0.2s ease;
        }
        input[type="text"]:focus {
            outline: none;
            border-color: #1f6feb;
            box-shadow: 0 0 0 3px rgba(31, 111, 235, 0.3);
        }
        input::placeholder {
            color: #6e7681;
        }
        button {
            padding: 0.75rem 1.5rem;
            background: #238636;
            color: #ffffff;
            border: 1px solid #238636;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        button:hover {
            background: #2ea043;
            border-color: #2ea043;
        }
        .results-section {
            background: #161b22;
            border: 1px solid #30363d;
            padding: 2rem;
            border-radius: 8px;
        }
        .results-section h3 {
            color: #f0f6fc;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .employee-card {
            background: #0d1117;
            border: 1px solid #30363d;
            padding: 1.5rem;
            border-radius: 6px;
            margin: 1rem 0;
        }
        .employee-card h4 {
            color: #f0f6fc;
            margin-bottom: 0.5rem;
        }
        .employee-card p {
            color: #8b949e;
            margin: 0.25rem 0;
        }
        .error {
            background: #490202;
            border: 1px solid #f85149;
            color: #f85149;
            padding: 1rem;
            border-radius: 6px;
            margin: 1rem 0;
        }
        .back-link {
            color: #58a6ff;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }
        .back-link:hover {
            color: #79c0ff;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Employee Search</h1>
    </div>

    <div class="nav-bar">
        <div class="nav-links">
            <a href="/" class="nav-link">Home</a>
            <a href="/search" class="nav-link active">Employee Search</a>
            <a href="/login" class="nav-link">Staff Login</a>
        </div>
    </div>

    <div class="container">
        <div class="search-section">
            <h2>Search Employee Directory</h2>
            <p style="color: #8b949e; margin-bottom: 1rem;">Find employees by name, email, or department</p>
            
            <form method="POST" action="/search" class="search-form">
                <input type="text" name="query" placeholder="Enter search query..." value="<%= query %>" required>
                <button type="submit">Search</button>
            </form>
        </div>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>

        <% if (results && results.length > 0) { %>
            <div class="results-section">
                <h3>Search Results (<%= results.length %> found)</h3>
                <% results.forEach(employee => { %>
                    <div class="employee-card">
                        <h4><%= employee.username %></h4>
                        <p><strong>Email:</strong> <%= employee.email %></p>
                        <p><strong>Role:</strong> <%= employee.role %></p>
                        <p><strong>ID:</strong> <%= employee.id %></p>
                    </div>
                <% }); %>
            </div>
        <% } else if (query && query.length > 0) { %>
            <div class="results-section">
                <h3>No Results Found</h3>
                <p style="color: #8b949e;">No employees found matching your search criteria.</p>
            </div>
        <% } %>

        <div style="text-align: center; margin-top: 2rem;">
            <a href="/dashboard" class="back-link">← Back to Dashboard</a>
        </div>
    </div>
</body>
</html>